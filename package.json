{
	"name": "squares",
	"description": "Real-time football squares pool app built with SvelteKit 5, Supabase, and Cloudflare Pages",
	"homepage": "https://squares.nathankrebs.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/nkrebs13/Squares"
	},
	"private": true,
	"version": "1.0.0",
	"author": "Nathan Krebs <https://github.com/nkrebs13>",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || true && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p e2e/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:report": "playwright show-report",
		"test:integration": "vitest run --config vitest.config.integration.ts",
		"check:bundle-size": "node scripts/check-bundle-size.mjs",
		"check:pwa-registration": "node scripts/check-pwa-registration.mjs",
		"screenshots": "tsx scripts/capture-screenshots.ts",
		"build:analyze": "vite-bundle-visualizer",
		"db:snapshot": "bash scripts/db-snapshot.sh",
		"db:types": "supabase gen types typescript --local > src/lib/database.types.ts"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css,md,html}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/pg": "^8.23.1",
		"@types/qrcode": "^1.5.6",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/coverage-v8": "^4.1.10",
		"dotenv": "^17.4.2",
		"eslint": "^10.7.0",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^17.0.7",
		"pg": "^8.21.0",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.0.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.4",
		"vite-bundle-visualizer": "1.2.1",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@sentry/sveltekit": "^10.55.0",
		"@supabase/supabase-js": "^2.110.2",
		"idb-keyval": "^6.3.0",
		"qrcode": "^1.5.4",
		"web-vitals": "^5.3.0"
	},
	"allowScripts": {
		"esbuild": false,
		"sharp": false,
		"workerd": false,
		"@sentry/cli": false,
		"fsevents": false
	}
}
