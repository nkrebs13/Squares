{
	"name": "squares",
	"description": "Real-time Super Bowl squares pool app built with SvelteKit 5, Supabase, and Cloudflare Pages",
	"homepage": "https://squares.nathankrebs.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/nkrebs13/Squares"
	},
	"private": true,
	"version": "1.0.0",
	"author": "Nathan Krebs <https://github.com/nkrebs13>",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || true && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:report": "playwright show-report",
		"test:integration": "vitest run --config vitest.config.integration.ts",
		"test:integration:ci": "npm run test:integration",
		"check:bundle-size": "node scripts/check-bundle-size.mjs",
		"build:analyze": "vite-bundle-visualizer",
		"db:types": "supabase gen types typescript --local > src/lib/database.types.ts"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css,md,html}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.58.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/coverage-v8": "^4.1.5",
		"eslint": "^10.4.0",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.5.0",
		"husky": "^9.1.7",
		"jsdom": "^28.1.0",
		"lint-staged": "^16.4.0",
		"pg": "^8.20.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.3",
		"vite": "^7.3.2",
		"vite-plugin-pwa": "^1.2.0",
		"vitest": "^4.1.5",
		"workbox-window": "^7.4.0"
	},
	"dependencies": {
		"@sentry/sveltekit": "^10.50.0",
		"@supabase/supabase-js": "^2.104.1",
		"@types/qrcode": "^1.5.6",
		"idb-keyval": "^6.2.2",
		"qrcode": "^1.5.4",
		"web-vitals": "^5.2.0"
	}
}
