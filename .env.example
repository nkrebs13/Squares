# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — used by the send-push Edge Function and the
# screenshot-capture script. Do NOT expose this in client-side code.
# Found in: Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Optional: screenshot capture script (scripts/capture-screenshots.ts) uses
# this as an alias for SUPABASE_SERVICE_ROLE_KEY for backward compatibility.
SUPABASE_SERVICE_KEY=

# Push notifications (VAPID keys)
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional: Error tracking + Web Vitals via Sentry.
# Leave blank to disable — the app works identically with no Sentry account.
# Free-tier signup at https://sentry.io. Project type: SvelteKit.
PUBLIC_SENTRY_DSN=

# Brand customization (optional — defaults preserve "Football Squares" branding)
# Override any of these at build time to rebrand a fork. All values are read by
# src/lib/config.ts; vite.config.ts also reads PUBLIC_APP_NAME / PUBLIC_APP_DESCRIPTION
# for the PWA manifest. Recommended max length for PUBLIC_APP_NAME is 20 chars
# to avoid hero overflow on mobile.
PUBLIC_APP_NAME=
PUBLIC_APP_TAGLINE=
PUBLIC_APP_DESCRIPTION=
PUBLIC_DEFAULT_TEAM_ROW_NAME=
PUBLIC_DEFAULT_TEAM_ROW_COLOR=
PUBLIC_DEFAULT_TEAM_ROW_LOGO=
PUBLIC_DEFAULT_TEAM_COL_NAME=
PUBLIC_DEFAULT_TEAM_COL_COLOR=
PUBLIC_DEFAULT_TEAM_COL_LOGO=
PUBLIC_CURRENCY_CODE=
PUBLIC_LOCALE=
