# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Push notifications (VAPID keys)
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional: Error tracking + Web Vitals via Sentry.
# Leave blank to disable — the app works identically with no Sentry account.
# Free-tier signup at https://sentry.io. Project type: SvelteKit.
PUBLIC_SENTRY_DSN=
